#!/bin/bash

# Stage Arch Linux ARM locally, with every package signature checked, then
# upload the stage to R2. The ARM counterpart of omarchy-mirror-sync.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
UPSTREAM="https://fl.us.mirror.archlinuxarm.org"
KEYRING="/etc/omarchy-mirror/alarm-build.gpg"
NULL_FILE="$SCRIPT_DIR/../config/arm-allow-null-records"
VERBOSE=""

while [[ $# -gt 0 ]]; do
  case $1 in
  --upstream)
    UPSTREAM="$2"
    shift 2
    ;;
  --stage)
    STAGE="$2"
    shift 2
    ;;
  --r2)
    R2="$2"
    shift 2
    ;;
  --keyring)
    KEYRING="$2"
    shift 2
    ;;
  --verbose)
    VERBOSE=true
    shift
    ;;
  *)
    echo "Unknown option: $1"
    echo "Usage: $0 --stage STAGE --r2 R2 [--upstream UPSTREAM] [--keyring FILE] [--verbose]"
    exit 1
    ;;
  esac
done

: "${STAGE:?--stage is required}" "${R2:?--r2 is required}"

# Upstream's known all-NUL .db records, one ARCH/REPO/MEMBER per line. Any
# other fails the run.
allow=()
while read -r entry; do
  [[ -z $entry || $entry == \#* ]] || allow+=(--allow-null-record "$entry")
done <"$NULL_FILE"

echo "Start syncing Omarchy ARM mirror"

"$SCRIPT_DIR/omarchy-mirror-stage-arm" --stage "$STAGE" --upstream "$UPSTREAM" \
  --repos core extra alarm aur --workers 16 --prune --keyring "$KEYRING" \
  --recover-null-records --publish-degraded "${allow[@]}"
# The snapshot the whole mirror now serves, at /lastsync as on x86_64's:
# omarchy-release and omarchy-mirror-promote-arm compare it. Every repository
# was staged by this run, so [core]'s stamp is all of theirs. The stager keeps
# freshness per repository, since it can be run for some of them.
cp "${STAGE%/}/aarch64/core/lastsync" "${STAGE%/}/lastsync"
"$SCRIPT_DIR/omarchy-mirror-upload-arm" --stage "$STAGE" --r2 "$R2" ${VERBOSE:+--verbose}

echo "Finished syncing Omarchy ARM mirror in ${SECONDS}s"
