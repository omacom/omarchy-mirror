#!/bin/bash

# Upload a complete Arch Linux ARM stage to R2: packages first, then the
# databases that name them, then prune. The same three steps copy one bucket
# onto another (omarchy-mirror-promote-arm), where R2 copies server-side.

set -euo pipefail

VERBOSE_RCLONE=""
DELTA=""

while [[ $# -gt 0 ]]; do
  case $1 in
  --stage)
    STAGE="$2"
    shift 2
    ;;
  --r2)
    R2="$2"
    shift 2
    ;;
  --delta)
    # The stage holds only what the bucket lacks (omarchy-mirror-stage-arm
    # --bucket-listing). Nothing is deleted for being absent from it.
    DELTA=true
    shift
    ;;
  --verbose)
    VERBOSE_RCLONE="-v"
    shift
    ;;
  *)
    echo "Unknown option: $1"
    echo "Usage: $0 --stage STAGE --r2 R2 [--delta] [--verbose]"
    exit 1
    ;;
  esac
done

: "${STAGE:?--stage is required}" "${R2:?--r2 is required}"
STAGE="${STAGE%/}"

# Only a stage whose last run completed, covered every repository in it and
# checked every signature may be uploaded: anything else can leave databases
# that name packages which are missing or unverified. The stager's own lock is
# held throughout, so the tree cannot change between the three steps.
if [[ $STAGE != *:* ]]; then
  exec 9>>"$STAGE.lock"
  if ! flock -n 9; then
    echo "Refusing to upload $STAGE: a stage run is using it" >&2
    exit 1
  fi

  status="$STAGE.status.json"
  if ! problem=$(python3 - "$status" "$STAGE" "$DELTA" 2>&1 <<'PY'
import json, sys
from pathlib import Path

try:
    report = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit("there is no readable status report")
if report.get("status") != "complete":
    sys.exit(f"last stage run is '{report.get('status')}'")
if report.get("signatures_verified") is not True:
    sys.exit("last stage run did not check signatures (--keyring)")
# A stage made from a bucket listing holds only new packages. Uploading it the
# ordinary way would delete everything else from the bucket.
if bool(report.get("bucket_listing")) != bool(sys.argv[3]):
    sys.exit("last stage run was made from a bucket listing; upload it with --delta" if report.get("bucket_listing")
             else "last stage run was not made from a bucket listing; --delta does not apply")
staged = {f"{arch.name}/{repo.name}" for arch in Path(sys.argv[2]).iterdir() if arch.is_dir()
          for repo in arch.iterdir() if repo.is_dir()}
skipped = sorted(staged - set(report.get("selected_repositories", [])))
if skipped:
    sys.exit(f"last stage run did not cover {', '.join(skipped)}")
PY
  ); then
    echo "Refusing to upload $STAGE: $problem ($status)" >&2
    exit 1
  fi
fi

# Packages above 200 MiB go up in parts (R2 takes 5 GiB in one request, 5 TiB
# in parts). The checksum R2 lists for those is not the file's, so rclone
# stores the file's MD5 with the object; a promote compares by it, and without
# it a same-size replacement would go unnoticed. Parts are buffered in memory:
# at most transfers x concurrency x chunk size, 4 GiB here.
COMMON=(--fast-list --s3-no-head --transfers=64 --checkers=64
  --s3-upload-concurrency=4 --s3-chunk-size=16M $VERBOSE_RCLONE)
INDEX=(--include '**/*.db' --include '**/*.db.*' --include '**/*.files' --include '**/*.files.*' --include '**/lastsync')
NOT_INDEX=(--exclude '**/*.db' --exclude '**/*.db.*' --exclude '**/*.files' --exclude '**/*.files.*' --exclude '**/lastsync')

# How a file is judged unchanged. Databases are small and are what clients
# read first, so they are always compared by checksum. Between two buckets
# everything is: the listing carries the checksum, so it costs nothing.
# Packages from the local stage are compared by time instead (reading 50 GiB
# to checksum it every hour is not worth it): a file is uploaded when it is
# newer than the copy R2 received, which is every file the stager wrote. It
# would miss a same-name replacement stamped older than its upload, so keep
# the clock synced and do not restore a stage with its old timestamps.
INDEX_CHANGED=(--checksum)
if [[ $STAGE == *:* || -n $DELTA ]]; then
  PACKAGE_CHANGED=(--checksum)
  # A copy inside R2 moves no data through this machine, only one request per
  # object, so more of them can be in flight: 127 objects/s against 80 at 64.
  COMMON+=(--transfers=256)
else
  PACKAGE_CHANGED=(--update --use-server-modtime)
fi

# 1) Packages and signatures (no deletes)
echo "Upload packages from $STAGE to $R2"
rclone copy "$STAGE" "$R2" "${COMMON[@]}" "${PACKAGE_CHANGED[@]}" "${NOT_INDEX[@]}"

# 2) Publish db/files + freshness markers, now that every package they name is there
echo "Upload db/files + lastsync from $STAGE to $R2"
rclone copy "$STAGE" "$R2" "${COMMON[@]}" "${INDEX_CHANGED[@]}" "${INDEX[@]}"

# 3) Prune (safe after the databases)
if [[ -n $DELTA ]]; then
  # The stager listed what the databases no longer name.
  if [[ -s $STAGE.obsolete ]]; then
    echo "Prune $(wc -l <"$STAGE.obsolete") removed files on $R2"
    rclone delete "$R2" --files-from-raw "$STAGE.obsolete" $VERBOSE_RCLONE
  fi
  # Everything staged is in the bucket now; keep only the databases.
  find "$STAGE" -type f \( -name '*.pkg.tar.*' \) -delete
else
  echo "Prune removed files on $R2"
  rclone sync "$STAGE" "$R2" "${COMMON[@]}" "${PACKAGE_CHANGED[@]}"
fi

echo "Finished uploading Arch Linux ARM mirror in ${SECONDS}s"
