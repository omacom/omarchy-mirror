[Unit]
Description=Omarchy Arch Linux ARM Mirror Promote Edge to RC
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/omarchy-mirror/r2.env
ExecStart=/root/omarchy-mirror/bin/omarchy-mirror-promote-arm --from "omarchy:omarchy-mirror-arm" --to "omarchy:omarchy-mirror-arm-rc"
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
